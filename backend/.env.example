# Copy to backend/.env and replace each placeholder with local values.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
TRUSTVAULT_JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_YOUR_SUPABASE_SERVICE_ROLE_KEY

# Set bootstrap credentials only when creating the initial administrator.
TRUSTVAULT_BOOTSTRAP_ADMIN_NAME=TrustVault Admin
TRUSTVAULT_BOOTSTRAP_ADMIN_EMAIL=
TRUSTVAULT_BOOTSTRAP_ADMIN_PASSWORD=

# Keep false outside local development; true creates a known test owner.
TRUSTVAULT_CREATE_TEST_OWNER=false
